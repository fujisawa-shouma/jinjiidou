function evaluateProperty({api, helpers}) {
	const recs = api.data.look_up_location.results;
	let items = recs.map((rec) => {
		return {
			id: rec._row_data.uniqueValue,
			label: rec.name.value
		};
	});
	// items.push({id: "", label: "-None-"});
	return items;
}]]></script>
